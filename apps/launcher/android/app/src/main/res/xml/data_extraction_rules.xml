<?xml version="1.0" encoding="utf-8"?>
<!-- Pairing token hashes must not leave the TV (cloud backup or device transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
